{
  "name": "calculus-tutor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:normal": "vitest run --reporter=verbose -t \"casos normales\"",
    "test:limite": "vitest run --reporter=verbose -t \"casos limite\"",
    "test:error": "vitest run --reporter=verbose -t \"caso erroneo\""
  },
  "dependencies": {
    "katex": "^0.16.44",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@mui/material": "^5.15.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react-swc": "3.8.0",
    "typescript": "5.8.3",
    "vite": "5.4.19",
    "vitest": "^2.0.0"
  }
}
